<?xml version="1.0" encoding="UTF-8"?>
<!--
Concrete OpenSCENARIO 1.0 scenario for CARLA Town01.

Scenario:
- Rear-end collision risk / lead vehicle braking.
- Ego vehicle is spawned by Scenario Runner but controlled externally by pid_ego_agent.py.
- LeadVehicle is controlled by OpenSCENARIO actions.
- Weather: rainy night / low friction.

Run with:
python scenario_runner.py --openscenario ~/scenario_runner/cenarios_concretos/town01_colisao_traseira_pid.xosc --reloadWorld --output --timeout 90
-->

<OpenSCENARIO>
  <FileHeader
    revMajor="1"
    revMinor="0"
    date="2026-06-15T00:00:00"
    description="Concrete rear-end collision scenario in CARLA Town01 with external PID ego control"
    author="Marcus + ChatGPT"/>

  <ParameterDeclarations>
    <!-- Speeds in m/s -->
    <ParameterDeclaration name="ego_cruise_speed" parameterType="double" value="22.22"/>
    <ParameterDeclaration name="lead_initial_speed" parameterType="double" value="16.67"/>

    <!-- Lead vehicle braking -->
    <ParameterDeclaration name="lead_deceleration_rate" parameterType="double" value="6.0"/>
    <ParameterDeclaration name="trigger_distance" parameterType="double" value="35.0"/>

    <!-- Weather and road condition -->
    <ParameterDeclaration name="rain_intensity" parameterType="double" value="0.80"/>
    <ParameterDeclaration name="friction_coefficient" parameterType="double" value="0.45"/>
  </ParameterDeclarations>

  <CatalogLocations/>

  <RoadNetwork>
    <!-- CARLA built-in map. Scenario Runner should load Town01 with --reloadWorld. -->
    <LogicFile filepath="Town01"/>
  </RoadNetwork>

  <Entities>
    <ScenarioObject name="Ego">
      <Vehicle name="vehicle.tesla.model3" vehicleCategory="car">
        <ParameterDeclarations/>
        <Performance maxSpeed="69.44" maxAcceleration="6.0" maxDeceleration="10.0"/>
        <BoundingBox>
          <Center x="1.40" y="0.00" z="0.75"/>
          <Dimensions width="1.85" length="4.70" height="1.50"/>
        </BoundingBox>
        <Axles>
          <FrontAxle maxSteering="0.60" wheelDiameter="0.60" trackWidth="1.60" positionX="1.40" positionZ="0.30"/>
          <RearAxle maxSteering="0.00" wheelDiameter="0.60" trackWidth="1.60" positionX="-1.40" positionZ="0.30"/>
        </Axles>
        <Properties>
          <!-- pid_ego_agent.py searches for role_name='hero'. -->
          <Property name="role_name" value="hero"/>
        </Properties>
      </Vehicle>
    </ScenarioObject>

    <ScenarioObject name="LeadVehicle">
      <Vehicle name="vehicle.audi.etron" vehicleCategory="car">
        <ParameterDeclarations/>
        <Performance maxSpeed="69.44" maxAcceleration="6.0" maxDeceleration="10.0"/>
        <BoundingBox>
          <Center x="1.40" y="0.00" z="0.75"/>
          <Dimensions width="1.85" length="4.70" height="1.60"/>
        </BoundingBox>
        <Axles>
          <FrontAxle maxSteering="0.60" wheelDiameter="0.60" trackWidth="1.60" positionX="1.40" positionZ="0.30"/>
          <RearAxle maxSteering="0.00" wheelDiameter="0.60" trackWidth="1.60" positionX="-1.40" positionZ="0.30"/>
        </Axles>
        <Properties>
          <Property name="role_name" value="lead_vehicle"/>
        </Properties>
      </Vehicle>
    </ScenarioObject>
  </Entities>

  <Storyboard>
    <Init>
      <Actions>
        <GlobalAction>
          <EnvironmentAction>
            <Environment name="RainyNightEnvironment">
              <TimeOfDay animation="false" dateTime="2026-06-15T01:30:00"/>
              <Weather cloudState="overcast">
                <Sun intensity="0.00" azimuth="0.00" elevation="-10.00"/>
                <Fog visualRange="120.00"/>
                <Precipitation precipitationType="rain" intensity="$rain_intensity"/>
              </Weather>
              <RoadCondition frictionScaleFactor="$friction_coefficient"/>
            </Environment>
          </EnvironmentAction>
        </GlobalAction>

        <!-- Ego starts behind the lead vehicle. Ego speed is NOT controlled here.
             The external Python PID agent controls Ego. -->
        <Private actorRef="Ego">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="-1" offset="0.0" s="50.0"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>

        <!-- Lead vehicle starts ahead and moves at 60 km/h. -->
        <Private actorRef="LeadVehicle">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <LanePosition roadId="1" laneId="-1" offset="0.0" s="110.0"/>
              </Position>
            </TeleportAction>
          </PrivateAction>

          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$lead_initial_speed"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>

    <Story name="RearEndStory">
      <Act name="LeadVehicleBrakingAct">
        <ManeuverGroup maximumExecutionCount="1" name="LeadVehicleBrakingGroup">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="LeadVehicle"/>
          </Actors>

          <Maneuver name="LeadVehicleBrakingManeuver">
            <Event name="LeadVehicleBrakeEvent" priority="overwrite">
              <Action name="LeadVehicleBrakeAction">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="linear" value="$lead_deceleration_rate" dynamicsDimension="rate"/>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="0.0"/>
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>

              <StartTrigger>
                <ConditionGroup>
                  <Condition name="StartBrakingWhenEgoIsClose" delay="0.0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities selectTriggeringEntities="false">
                        <EntityRef entityRef="Ego"/>
                      </TriggeringEntities>
                      <EntityCondition>
                        <RelativeDistanceCondition
                          entityRef="LeadVehicle"
                          relativeDistanceType="longitudinal"
                          value="$trigger_distance"
                          freespace="false"
                          rule="lessThan"/>
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>

        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActStartImmediately" delay="0.0" conditionEdge="rising">
              <ByValueCondition>
                <SimulationTimeCondition value="0.1" rule="greaterThan"/>
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>

        <StopTrigger>
          <ConditionGroup>
            <Condition name="StopAfterThirtySeconds" delay="0.0" conditionEdge="rising">
              <ByValueCondition>
                <SimulationTimeCondition value="30.0" rule="greaterThan"/>
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StopTrigger>
      </Act>
    </Story>

    <StopTrigger>
      <ConditionGroup>
        <Condition name="ScenarioTimeout" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition value="35.0" rule="greaterThan"/>
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>