<?xml version="1.0" encoding="UTF-8"?>
<OpenSCENARIO>
  <FileHeader revMajor="1" revMinor="2" date="2026-11-20T12:00:00" description="MSCA STEP-UP DC2: Smartphone-Distracted Pedestrian Midblock Crossing" author="Horizon Europe MSCA STEP-UP Consortium"/>
  <ParameterDeclarations>
    <ParameterDeclaration name="EgoInitSpeedMs" parameterType="double" value="11.11"/>
    <ParameterDeclaration name="DistractedWalkSpeedMs" parameterType="double" value="1.12"/>
    <ParameterDeclaration name="TriggerDistanceM" parameterType="double" value="28.0"/>
  </ParameterDeclarations>
  <CatalogLocations/>
  <RoadNetwork>
    <LogicFile filepath="Town03"/>
    <SceneGraphFile filepath=""/>
  </RoadNetwork>
  <Entities>
    <ScenarioObject name="ego_vehicle">
      <Vehicle name="vehicle.lincoln.mkz_2020" vehicleCategory="car">
        <ParameterDeclarations/>
        <Performance maxSpeed="50.0" maxAcceleration="4.0" maxDeceleration="8.5"/>
        <BoundingBox>
          <Center x="1.4" y="0.0" z="0.75"/>
          <Dimensions width="2.0" length="4.9" height="1.5"/>
        </BoundingBox>
        <Axles>
          <FrontAxle maxSteering="0.5" wheelDiameter="0.7" trackWidth="1.7" positionX="2.8" positionZ="0.35"/>
          <RearAxle maxSteering="0.0" wheelDiameter="0.7" trackWidth="1.7" positionX="0.0" positionZ="0.35"/>
        </Axles>
        <Properties>
          <Property name="type" value="ego_vehicle"/>
          <Property name="ehmi_mode" value="VRU_DETECTED_YIELDING"/>
        </Properties>
      </Vehicle>
    </ScenarioObject>
    <ScenarioObject name="ped_phone_distracted">
      <Pedestrian model="walker.pedestrian.0001" mass="72.0" name="walker.pedestrian.0001" pedestrianCategory="pedestrian">
        <ParameterDeclarations/>
        <BoundingBox>
          <Center x="0.0" y="0.0" z="0.88"/>
          <Dimensions width="0.50" length="0.50" height="1.75"/>
        </BoundingBox>
        <Properties>
          <Property name="stepup_archetype" value="adult_phone"/>
          <Property name="gaze_state" value="ON_PHONE"/>
          <Property name="neck_pitch_deg" value="32.0"/>
          <Property name="forearm_r_pitch_deg" value="-65.0"/>
        </Properties>
      </Pedestrian>
    </ScenarioObject>
  </Entities>
  <Storyboard>
    <Init>
      <Actions>
        <GlobalAction>
          <EnvironmentAction>
            <Environment name="UrbanDaylight">
              <TimeOfDay animation="false" dateTime="2026-06-15T14:00:00"/>
              <Weather cloudState="free">
                <Sun intensity="0.90" azimuth="1.2" elevation="1.1"/>
                <Fog visualRange="100000.0"/>
                <Precipitation precipitationType="dry" intensity="0.0"/>
              </Weather>
              <RoadCondition frictionScaleFactor="1.0"/>
            </Environment>
          </EnvironmentAction>
        </GlobalAction>
        <Private entityRef="ego_vehicle">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="42.0" y="-1.75" z="0.3" h="3.14159" p="0.0" r="0.0"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedAction>
                <SpeedActionDynamics dynamicsShape="step" value="0.0" dynamicsDimension="time"/>
                <SpeedActionTarget>
                  <AbsoluteTargetSpeed value="$EgoInitSpeedMs"/>
                </SpeedActionTarget>
              </SpeedAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="ped_phone_distracted">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="0.0" y="-5.4" z="0.3" h="1.5708" p="0.0" r="0.0"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="PhoneDistractedCrossingStory">
      <Act name="PhoneDistractedCrossingAct">
        <ManeuverGroup maximumExecutionCount="1" name="PedestrianCrossingSequence">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="ped_phone_distracted"/>
          </Actors>
          <Maneuver name="StepIntoCrosswalkWhileOnPhone">
            <Event name="StartDistractedWalkEvent" priority="overwrite">
              <Action name="WalkAcrossRoadAction">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedAction>
                      <SpeedActionDynamics dynamicsShape="linear" value="0.35" dynamicsDimension="time"/>
                      <SpeedActionTarget>
                        <AbsoluteTargetSpeed value="$DistractedWalkSpeedMs"/>
                      </SpeedActionTarget>
                    </SpeedAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="EgoWithinTriggerRange" delay="0.0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="ego_vehicle"/>
                      </TriggeringEntities>
                      <EntityCondition>
                        <RelativeDistanceCondition entityRef="ped_phone_distracted" relativeDistanceType="euclidianDistance" value="$TriggerDistanceM" freespace="false" rule="lessThan"/>
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="ActImmediateStart" delay="0.0" conditionEdge="rising">
              <ByValueCondition>
                <SimulationTimeCondition value="0.0" rule="greaterOrEqual"/>
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="TimeoutStopCondition" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition value="18.0" rule="greaterThan"/>
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
      <ConditionGroup>
        <Condition name="criteria_CollisionTest" delay="0.0" conditionEdge="rising">
          <ByValueCondition>
            <ParameterCondition parameterRef="" value="" rule="lessThan"/>
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
</OpenSCENARIO>
