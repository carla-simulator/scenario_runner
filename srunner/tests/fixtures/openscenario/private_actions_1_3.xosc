                            <WorldPosition x="20" y="5" z="0" h="0"/>
                          </Position>
                        </Vertex>
                      </Polyline>
                    </Shape>
                  </Trajectory>
                </TrajectoryRef>
                <TimeReference>
                  <Timing domainAbsoluteRelative="relative" offset="1.0" scale="$TimeScale"/>
                </TimeReference>
                <TrajectoryFollowingMode followingMode="position"/>
              </FollowTrajectoryAction>
            </RoutingAction>
          </PrivateAction>
        </Private>
      </Actions>
    </Init>
    <Story name="MyStory">
      <Act name="Behavior">
        <ManeuverGroup maximumExecutionCount="1" name="NpcGroup">
          <Actors selectTriggeringEntities="false">
            <EntityRef entityRef="npc"/>
          </Actors>
          <Maneuver name="NpcGroupManeuver">
            <Event name="StorySpeedProfile" priority="override">
              <Action name="StorySpeedProfile">
                <PrivateAction>
                  <LongitudinalAction>
                    <SpeedProfileAction followingMode="follow" entityRef="hero">
                      <DynamicConstraints maxAcceleration="3.0" maxDeceleration="5.0"/>
                      <SpeedProfileEntry speed="5.0" time="2.0"/>
                      <SpeedProfileEntry speed="8.0"/>
                    </SpeedProfileAction>
                  </LongitudinalAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="AngleStart" delay="0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="npc"/>
                      </TriggeringEntities>
                      <EntityCondition>
                        <RelativeAngleCondition entityRef="hero" angleType="heading" angle="0.0" angleTolerance="0.1"/>
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
            <Event name="StoryAcquirePosition" priority="override">
              <Action name="StoryAcquirePosition">
                <PrivateAction>
                  <RoutingAction>
                    <AcquirePositionAction>
                      <Position>
                        <WorldPosition x="92" y="13.5" z="0" h="0"/>
                      </Position>
                    </AcquirePositionAction>
                  </RoutingAction>
                </PrivateAction>
              </Action>
              <StartTrigger>
                <ConditionGroup>
                  <Condition name="ClearanceStart" delay="0" conditionEdge="rising">
                    <ByEntityCondition>
                      <TriggeringEntities triggeringEntitiesRule="any">
                        <EntityRef entityRef="npc"/>
                      </TriggeringEntities>
                      <EntityCondition>
                        <RelativeClearanceCondition oppositeLanes="false" distanceForward="20.0" distanceBackward="5.0" freeSpace="true">
                          <RelativeLaneRange from="-1" to="1"/>
                          <EntityRef entityRef="hero"/>
                        </RelativeClearanceCondition>
                      </EntityCondition>
                    </ByEntityCondition>
                  </Condition>
                </ConditionGroup>
              </StartTrigger>
            </Event>
          </Maneuver>
        </ManeuverGroup>
        <StartTrigger>
          <ConditionGroup>
            <Condition name="OverallStartCondition" delay="0" conditionEdge="rising">
              <ByValueCondition>
                <SimulationTimeCondition value="0" rule="greaterThan"/>
              </ByValueCondition>
            </Condition>
          </ConditionGroup>
        </StartTrigger>
      </Act>
    </Story>
    <StopTrigger>
      <ConditionGroup>
        <Condition name="EndCondition" delay="0" conditionEdge="rising">
          <ByValueCondition>
            <SimulationTimeCondition value="100" rule="greaterThan"/>
          </ByValueCondition>
        </Condition>
      </ConditionGroup>
    </StopTrigger>
  </Storyboard>
