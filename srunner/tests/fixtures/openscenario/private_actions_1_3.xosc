  <Storyboard>
    <Init>
      <Actions>
        <Private entityRef="hero">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="0" y="2" z="0" h="0"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
        </Private>
        <Private entityRef="npc">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="5" y="2" z="0" h="0"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <LongitudinalAction>
              <SpeedProfileAction followingMode="follow">
                <DynamicConstraints maxAcceleration="3.0" maxDeceleration="5.0"/>
                <SpeedProfileEntry speed="5.0" time="2.0"/>
                <SpeedProfileEntry speed="8.0"/>
              </SpeedProfileAction>
            </LongitudinalAction>
          </PrivateAction>
        </Private>
        <Private entityRef="follower">
          <PrivateAction>
            <TeleportAction>
              <Position>
                <WorldPosition x="0" y="5" z="0" h="0"/>
              </Position>
            </TeleportAction>
          </PrivateAction>
          <PrivateAction>
            <RoutingAction>
              <FollowTrajectoryAction>
                <TrajectoryRef>
                  <Trajectory name="InitTrajectory" closed="false">
                    <Shape>
                      <Polyline>
                        <Vertex time="0">
                          <Position>
                            <WorldPosition x="0" y="5" z="0" h="0"/>
                          </Position>
                        </Vertex>
                        <Vertex time="2">
                          <Position>
                            <WorldPosition x="10" y="5" z="0" h="0"/>
                          </Position>
                        </Vertex>
                        <Vertex time="4">
